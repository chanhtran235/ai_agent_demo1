# Docker Compose MySQL development database
MYSQL_DATABASE=student_management
MYSQL_USER=student_user
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_password

# Backend database connection and browser origin
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_management
DB_USERNAME=student_user
DB_PASSWORD=replace_with_a_strong_password
FRONTEND_URL=http://localhost:5173

# Frontend API base URL
VITE_API_BASE_URL=http://localhost:8080/api
